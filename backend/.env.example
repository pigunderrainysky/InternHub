# Supabase PostgreSQL connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-string

# Resend API key (for email digests)
RESEND_API_KEY=re_xxxxxxxx

# Email sender
EMAIL_FROM=InternHub <noreply@internhub.app>

# CORS (comma-separated in production)
CORS_ORIGINS=["http://localhost:5173","https://your-app.vercel.app"]
